{
  "name": "possumed-autocomplete",
  "version": "3.1.3",
  "main": "dist/accessible-autocomplete.min.js",
  "style": "dist/accessible-autocomplete.min.css",
  "description": "An autocomplete component, built to be accessible.",
  "repository": "callandr/possumed-autocomplete",
  "author": "Government Digital Service as well as opossums",
  "license": "MIT",
  "keywords": [
    "a11y",
    "accessibility",
    "autocomplete",
    "component",
    "plugin",
    "typeahead",
    "widget"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --progress",
    "dev": "cross-env NODE_ENV=development webpack serve",
    "prepare": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "version": "git add -A dist"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/eslint-parser": "^7.23.10",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@babel/preset-env": "^7.23.9",
    "autoprefixer": "^10.4.17",
    "babel-loader": "^9.1.3",
    "chalk": "^5.3.0",
    "core-js": "^3.36.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "cssnano": "^6.0.3",
    "cssnano-preset-default": "^6.0.3",
    "husky": "^9.1.5",
    "mini-css-extract-plugin": "^2.8.0",
    "postcss": "^8.4.35",
    "postcss-loader": "^8.1.0",
    "preact": "^8.5.3",
    "source-map-loader": "^5.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "5.92",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "5.1"
  },
  "peerDependencies": {
    "preact": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  }
}
